# Component 4 - Standalone Video Analytics & Event Detection
# Copy to .env before running Compose:  cp .env.example .env
#
# Every value here is a NON-SECRET local development example.

# --- Compose host-side only -------------------------------------------------
ANALYTICS_HTTP_PORT=8100

# --- Container paths --------------------------------------------------------
ANALYTICS_DATA_DIR=/data
ANALYTICS_DB_PATH=/data/analytics.db
ANALYTICS_EVENT_DIR=/data/events

# --- Model ------------------------------------------------------------------
ANALYTICS_MODEL_PATH=/opt/models/yolo11n.pt
ANALYTICS_MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1

# --- Runtime tuning ---------------------------------------------------------
ANALYTICS_TORCH_THREADS=2
ANALYTICS_JPEG_QUALITY=90
ANALYTICS_STALL_SECONDS=10
ANALYTICS_STOP_TIMEOUT_SECONDS=10
ANALYTICS_LOG_LEVEL=INFO

# --- External VMS (Component 3) read-only recording lookup ------------------
# Must be reachable FROM the analytics container.
VMS_API_BASE_URL=http://host.docker.internal:8090

# --- Event cursor signing ---------------------------------------------------
# WARNING: this is a well-known local development value. EVERY non-local
# deployment MUST replace it before the first start, or event page cursors
# issued by this service can be forged by anyone who read this file.
CURSOR_SIGNING_KEY=component4-local-development-key-change-me
