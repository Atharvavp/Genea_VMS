# Component 5 - Standalone Semantic Image Retrieval & Historical Event Search.
#
# Copy to .env and adjust. Every value here is optional: the defaults below are
# the ones baked into the image. No secret, token, or credential belongs in this
# file - Component 5 needs none at runtime (the model is baked at build time and
# loaded offline).

# Host port the dashboard and API are published on.
SEMANTIC_HTTP_PORT=8200

# Component 4's public HTTP base URL. This is the ONLY upstream Component 5
# talks to. It must be a scheme://host[:port] URL with no credentials, query, or
# fragment. Component 5 never reads Component 4's database or filesystem.
COMPONENT4_API_BASE_URL=http://host.docker.internal:8100

# CPU threads the embedding model may use.
SEMANTIC_TORCH_THREADS=2

# Images embedded per model call (1..8). Four is the measured default.
SEMANTIC_INDEX_BATCH_SIZE=4

# Discovery cadence.
SEMANTIC_POLL_INTERVAL_SECONDS=10
SEMANTIC_OVERLAP_SECONDS=300
SEMANTIC_FULL_RECONCILE_SECONDS=21600
SEMANTIC_MAX_RETRY_SECONDS=300

# Upload and upstream image bounds.
SEMANTIC_UPLOAD_MAX_BYTES=8388608
SEMANTIC_UPLOAD_MAX_PIXELS=16777216
SEMANTIC_UPSTREAM_IMAGE_MAX_BYTES=16777216

# Graceful shutdown budget, seconds.
SEMANTIC_SHUTDOWN_TIMEOUT_SECONDS=15

# DEBUG | INFO | WARNING | ERROR
SEMANTIC_LOG_LEVEL=INFO
