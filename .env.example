# Copy to .env to override docker-compose defaults.

# Where FFmpeg publishes to (simulator -> mediamtx, over the compose network).
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554

# What the UI/API advertise to RTSP clients running on the host.
PUBLIC_RTSP_HOST=localhost
PUBLIC_RTSP_PORT=8554

# RTSP path prefix: rtsp://<host>:<port>/<prefix>/<stream_path>
RTSP_PATH_PREFIX=simulator

# Simulator HTTP port (host side).
SIMULATOR_HTTP_PORT=8080

# Storage inside the simulator container.
DATA_DIR=/data
DATABASE_PATH=/data/simulator.db
UPLOAD_VIDEO_DIR=/data/videos
SOURCE_VIDEO_DIR=/data/local-sources

# Upload limit in bytes (default 2 GiB).
MAX_UPLOAD_BYTES=2147483648

# FFmpeg process supervision knobs.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_STARTUP_GRACE_SECONDS=2.0
FFMPEG_STOP_TIMEOUT_SECONDS=5.0
FFMPEG_STDERR_TAIL_LINES=50
FFPROBE_TIMEOUT_SECONDS=20.0

LOG_LEVEL=INFO
