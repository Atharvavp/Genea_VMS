# Copy to .env to override docker-compose defaults.

# --- Host ports -------------------------------------------------------------
# VMS UI + REST API.
VMS_HTTP_PORT=8090
# VMS MediaMTX RTSP (8554 belongs to the simulator stack; VMS uses 8555).
VMS_RTSP_PORT=8555
# WebRTC signalling/WHEP, and the single UDP port used for ICE.
VMS_WEBRTC_HTTP_PORT=8889
VMS_WEBRTC_ICE_UDP_PORT=8189

# --- Backend ----------------------------------------------------------------
# Host the browser should use for WebRTC. `localhost` is right for Docker
# Desktop; set it to the machine's address when serving other machines.
PUBLIC_WEBRTC_HOST=localhost
# Control API address inside the compose network (never published to the host).
MEDIAMTX_API_URL=http://vms-mediamtx:9997
DATABASE_PATH=/data/vms.db
# How often camera health is refreshed from MediaMTX.
CAMERA_HEALTH_POLL_SECONDS=2.0
# Floor between reconciles triggered by drift the health poll noticed. Startup,
# camera mutations and MediaMTX recovery are not subject to it.
RECONCILE_MIN_INTERVAL_SECONDS=10.0

LOG_LEVEL=INFO
