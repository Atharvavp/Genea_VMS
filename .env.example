# Copy to .env to override docker-compose defaults.

# --- Host ports -------------------------------------------------------------
# VMS UI + REST API.
VMS_HTTP_PORT=8090
# VMS MediaMTX RTSP (8554 belongs to the simulator stack; VMS uses 8555).
VMS_RTSP_PORT=8555
# WebRTC signalling/WHEP, and the single UDP port used for ICE.
VMS_WEBRTC_HTTP_PORT=8889
VMS_WEBRTC_ICE_UDP_PORT=8189
# Historical playback: the browser fetches recorded media from this port.
VMS_PLAYBACK_HTTP_PORT=9996

# --- Backend ----------------------------------------------------------------
# Host the browser should use for WebRTC. `localhost` is right for Docker
# Desktop; set it to the machine's address when serving other machines.
PUBLIC_WEBRTC_HOST=localhost
# Host the browser should use for recorded playback. Leave unset to follow
# PUBLIC_WEBRTC_HOST, so live and playback are advertised on the same host.
PUBLIC_PLAYBACK_HOST=localhost
# Control API address inside the compose network (never published to the host).
MEDIAMTX_API_URL=http://vms-mediamtx:9997
# Playback server address inside the compose network. The VMS queries it for
# what history exists; the browser uses PUBLIC_PLAYBACK_* to fetch the media.
MEDIAMTX_PLAYBACK_URL=http://vms-mediamtx:9996
DATABASE_PATH=/data/vms.db
# How often camera health is refreshed from MediaMTX.
CAMERA_HEALTH_POLL_SECONDS=2.0
# Floor between reconciles triggered by drift the health poll noticed. Startup,
# camera mutations and MediaMTX recovery are not subject to it.
RECONCILE_MIN_INTERVAL_SECONDS=10.0

# --- Recording --------------------------------------------------------------
# Recording root *inside the MediaMTX container*. Files land at
# <root>/<mediamtx_path>/<YYYY-MM-DD>/<HH-MM-SS-ffffff>.mp4.
RECORDING_STORAGE_PATH=/recordings
# Where that root lives on the host. Empty means the `vms-recordings` named
# volume, which survives `docker compose down` and is wiped by `down -v`. Set a
# host directory (e.g. ./recordings) to inspect the files directly.
RECORDING_STORAGE_HOST_PATH=
# Minimum length of one recorded segment, in MediaMTX duration syntax (ms/s/m/h).
# A floor, not a guarantee: real boundaries follow keyframes. Use something like
# 5s for a demo rather than waiting five minutes.
RECORDING_SEGMENT_DURATION=5m
# How long finalised recordings are kept. MediaMTX deletes them itself; the VMS
# runs no cleanup job. Fractions are allowed, so 0.01 (36s) is a testable value.
RECORDING_RETENTION_HOURS=24

LOG_LEVEL=INFO
